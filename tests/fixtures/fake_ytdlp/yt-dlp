#!/usr/bin/env python3
"""Fake yt-dlp for the network-free fetch tests (step 4.7).

The fetch tests put this script's folder in front of ``PATH``, so
:mod:`sortiton.features.fetch` starts this program instead of the real yt-dlp.
It never touches the network: the preview prints one prepared metadata line,
the download writes a small file plus exactly the machine lines the feature
parses (``SORTITON_PROGRESS`` / ``SORTITON_FILE``), and it can append its
download-archive line so the restore path has something to undo.

Three environment variables let the cancellation test drive the process:

``SORTITON_FAKE_YTDLP_SLOW``
    keep running (printing progress) instead of finishing at once,
``SORTITON_FAKE_YTDLP_PIDFILE``
    write the process id here right after the file is created,
``SORTITON_FAKE_YTDLP_TERMFILE``
    write a marker here when the process receives ``SIGTERM``.

Keeping the fake a real program (and not a monkey-patched Python function)
is the point: the tests exercise the actual ``Popen``/pipe/cancel handling.
"""

from __future__ import annotations

import os
import signal
import sys
import time
from pathlib import Path

SEP = "\t"
URL = "https://example.org/watch?v=abc"
TITLE = "Fake Song"
DURATION = "215"
ARCHIVE_ID = "youtube abc123"
SLOW_SECONDS = 8.0
SLOW_STEP = 0.1


def _option(args: list[str], flags: tuple[str, ...]) -> str | None:
    """Value that follows one of ``flags`` (``-P dir`` or ``--paths=dir``)."""
    for index, arg in enumerate(args):
        for flag in flags:
            if arg == flag and index + 1 < len(args):
                return args[index + 1]
            if arg.startswith(flag + "="):
                return arg[len(flag) + 1:]
    return None


def _marker(variable: str) -> str:
    """Path stored in an environment variable, or ``""``."""
    return os.environ.get(variable, "")


def _write_archive(args: list[str]) -> None:
    """Append this run's line, like the real ``--download-archive`` does."""
    archive = _option(args, ("--download-archive",))
    if not archive:
        return
    with open(archive, "a", encoding="utf-8") as handle:
        handle.write(ARCHIVE_ID + "\n")


def _progress(done: int, total: int) -> None:
    print("SORTITON_PROGRESS" + SEP + str(done) + SEP + str(total) + SEP + "NA")
    sys.stdout.flush()


def _preview(args: list[str]) -> int:
    """Print the one metadata line the feature's ``--print`` template asks for."""
    url = args[-1] if args else URL
    print("SORTITON_META" + SEP + url + SEP + TITLE + SEP + DURATION)
    return 0


def _install_term_marker() -> None:
    """Record a ``SIGTERM`` in a file, so a test can prove the kill happened."""
    marker = _marker("SORTITON_FAKE_YTDLP_TERMFILE")
    if not marker:
        return

    def handler(_signum, _frame):
        Path(marker).write_text("terminated", encoding="utf-8")
        raise SystemExit(143)

    signal.signal(signal.SIGTERM, handler)


def _download(args: list[str]) -> int:
    """Write a small file and the machine lines, like a finished download."""
    target = Path(_option(args, ("-P", "--paths")) or ".")
    target.mkdir(parents=True, exist_ok=True)
    path = (target / (TITLE + ".mp3")).resolve()
    path.write_text("fake audio", encoding="utf-8")
    _write_archive(args)

    pidfile = _marker("SORTITON_FAKE_YTDLP_PIDFILE")
    if pidfile:
        Path(pidfile).write_text(str(os.getpid()), encoding="utf-8")

    if _marker("SORTITON_FAKE_YTDLP_SLOW"):
        _install_term_marker()
        deadline = time.monotonic() + SLOW_SECONDS
        done = 0
        while time.monotonic() < deadline:
            done = (done + 1) % 100
            _progress(done, 100)
            time.sleep(SLOW_STEP)
    else:
        for done in (10, 50, 100):
            _progress(done, 100)

    print("SORTITON_FILE" + SEP + str(path))
    return 0


def main() -> int:
    """Dispatch on the arguments the feature passes; never touch the network."""
    args = sys.argv[1:]
    if any("SORTITON_META" in arg for arg in args):
        return _preview(args)
    if any(arg.startswith("after_move:SORTITON_FILE") for arg in args):
        return _download(args)
    sys.stderr.write("fake yt-dlp: unexpected call\n")
    return 3


if __name__ == "__main__":
    raise SystemExit(main())
